NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000

# false (default) = usa el microservicio restosync-ia en NEXT_PUBLIC_AI_SERVICE_URL
#                   para la lectura de tickets (la GEMINI_API_KEY vive en el .env de ese servicio)
# true  = no llama a restosync-ia; usa datos de ejemplo (solo para desarrollar sin el servicio)
NEXT_PUBLIC_USE_IA_MOCK=false
